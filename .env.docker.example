# ==============================================================================
# Docker Compose Environment Configuration (EduLabs + Judge0 CE)
# ==============================================================================
# Copy this file to .env before starting containers:
#   cp .env.docker.example .env
#
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL!
# ==============================================================================

# Supabase Configuration (REQUIRED for DB operations and auth token verification)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Judge0 API Internal Network Address
# Uses the internal Docker container name 'judge0-server' (port 2358)
JUDGE0_API_URL=http://judge0-server:2358
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# CORS Allowed Origins (Must include your Vite frontend dev server URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# FastAPI Host & Port
HOST=0.0.0.0
PORT=8000

# Demo Login Credentials (For evaluation and demo login bypass)
ENABLE_DEMO_LOGIN=true
DEMO_STUDENT_EMAIL=student001@college.edu
DEMO_STUDENT_PASSWORD=StudentPassword@2026
DEMO_FACULTY_EMAIL=faculty001@college.edu
DEMO_FACULTY_PASSWORD=FacultyPassword@2026
