# Judge0 API Configuration
# ------------------------------------------------------------------------------
# Option A (Recommended): Docker Compose Self-Hosted Stack
# When running the FastAPI container inside Docker Compose, it connects internally:
# JUDGE0_API_URL=http://judge0-server:2358
# If running FastAPI locally while Judge0 runs in Docker:
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=  # No key required for self-hosted Judge0
JUDGE0_API_HOST=

# Option B: RapidAPI Hosted Judge0 (Cloud Fallback if Docker is unavailable)
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your-rapidapi-key
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Supabase Configuration (REQUIRED — no defaults, server will fail without these)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Demo Login Configuration (For evaluators and judging - disabled by default in production)
ENABLE_DEMO_LOGIN=true
DEMO_STUDENT_EMAIL=student001@college.edu
DEMO_STUDENT_PASSWORD=your-demo-student-password-here
DEMO_FACULTY_EMAIL=faculty001@college.edu
DEMO_FACULTY_PASSWORD=your-demo-faculty-password-here
