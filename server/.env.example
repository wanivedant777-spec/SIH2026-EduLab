# Judge0 API Configuration
# Option A: RapidAPI hosted Judge0
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your-rapidapi-key
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Option B: Self-Hosted Judge0 instance (e.g. docker-compose)
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=  # No need to give API key if self hosting
JUDGE0_API_HOST=

# Supabase Configuration (REQUIRED — no defaults, server will fail without these)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Demo Login Configuration (For evaluators and judging - disabled by default in production)
ENABLE_DEMO_LOGIN=true
DEMO_STUDENT_EMAIL=student001@college.edu
DEMO_STUDENT_PASSWORD=StudentPassword@2026
DEMO_FACULTY_EMAIL=faculty001@college.edu
DEMO_FACULTY_PASSWORD=FacultyPassword@2026
